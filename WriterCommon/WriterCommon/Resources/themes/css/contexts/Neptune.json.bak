{
    
    "name": "Neptune",
    
    "theme": {
 
        "dark": {
            "background": {
                "color": "#0B0D24"
            }
        },
        "light": {
            "background": {
                "color": "#95F4FF"
            }
        },
        "print": {
            "body": {
                "fontSize": "10pt"
            },
            "h1": {
                "fontSize": "14pt"
            },
            "h2": {
                "fontSize": "13pt"
            },
            "h3": {
                "fontSize": "12pt"
            },
            "h4": {
                "fontSize": "11pt"
            },
            "h5": {
                "fontSize": "11pt"
            },
            "h6": {
                "fontSize": "10pt"
            }
        },
        "css": {
 
            "foreground": {
                "color": "#5D9AF3",
                "fontFamily": "Hack",
                "fontSize": "10pt"
            },
            "source": {
                "function": {
                    "color": "#3546B0"
                },
                "comment": {
                    "color": "#3546B0"
                },
                "classSelector": {
                    "color": "#2D3586"
                },
                "atRuleName": {
                    "color": "#3546B0"
                },
                "namespacePrefix": {
                    "color": "#3546B0"
                },
                "namespaceUri": {
                    "color": "#3546B0"
                },
                "typeSelector": {
                    "color": "#3546B0"
                },
                "attributeName": {
                    "color": "#3546B0"
                },
                "attributeMatch": {
                    "color": "#3546B0"
                },
                "combinator": {
                    "color": "#3546B0"
                },
                "propertyName": {
                    "color": "#3546B0"
                },
                "importantExclamationPoint": {
                    "color": "#3546B0"
                },
                "importantText": {
                    "color": "#3546B0"
                },
                "string": {
                    "color": "#5D9AF3"
                },
                "fontStyle": {
                    "color": "#3546B0"
                },
                "colorKeyword": {
                    "color": "#3546B0"
                },
                "dimension": {
                    "color": "#3546B0"
                },
                "number": {
                    "color": "#5D9AF3"
                },
                "invalid": {
                    "color": "#707299"
                },
                "pseudoSelectorOperator": {
                    "color": "#3546B0"
                },
                "pseudoSelectorValue": {
                    "color": "#3546B0"
                }
            },
            "errors": {

                "unselectedErrorMessage": {
                    "color": "#E61F44"
                },
                "selectedErrorMessage": {
                    "color": "#B12100"
                }                
            }
        },
        "html": {
            
            "preview": {
                
                "dark": {
                    "foreground": {
                        "color": "white"
                    }
                },
                "light": {
                    "foreground": {
                        "color": "#5D9AF3"
                    }
                }
            }
        }
    }
}

