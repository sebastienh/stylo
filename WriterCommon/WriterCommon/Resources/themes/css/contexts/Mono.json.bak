{
    
    "name": "Mono",
    
    "theme": {

        "dark": {
            "background": {
                "color": "#1E1E1E"
            }
        },
        "light": {
            "background": {
                "color": "#F7F7F7"
            }
        },
        "print": {
            "body": {
                "fontSize": "10pt"
            },
            "h1": {
                "fontSize": "14pt"
            },
            "h2": {
                "fontSize": "13pt"
            },
            "h3": {
                "fontSize": "12pt"
            },
            "h4": {
                "fontSize": "11pt"
            },
            "h5": {
                "fontSize": "11pt"
            },
            "h6": {
                "fontSize": "10pt"
            }
        },
        "css": {
            
            "foreground": {
                "color": "#E69300",
                "fontFamily": "Hack",
                "fontSize": "10pt"
            },
            "source": {
                
                "function": {
                    "color": "#01768B"
                },
                "comment": {
                    "color": "#C8C8C8"
                },
                "classSelector": {
                    "color": "#01768B"
                },
                "atRuleName": {
                    "color": "#DCDCDC"
                },
                "namespacePrefix": {
                    "color": "#DCDCDC"
                },
                "namespaceUri": {
                    "color": "#DCDCDC"
                },
                "typeSelector": {
                    "color": "#136F63"
                },
                "attributeName": {
                    "color": "#DCDCDC"
                },
                "attributeMatch": {
                    "color": "#DCDCDC"
                },
                "combinator": {
                    "color": "#DCDCDC"
                },
                "propertyName": {
                    "color": "#004777"
                },
                "important": {
                    "color": "#DCDCDC"
                },
                "string": {
                    "color": "#B4B4B4"
                },
                "fontStyle": {
                    "color": "#DCDCDC"
                },
                "colorKeyword": {
                    "color": "#B83712"
                },
                "colorHash": {
                    "color": "#B83712"
                },
                "dimension": {
                    "color": "#83B692"
                },
                "number": {
                    "color": "#B4B4B4"
                },
                "invalid": {
                    "color": "#FF4E00"
                },
                "pseudoSelectorOperator": {
                    "color": "#B4B4B4"
                },
                "pseudoSelectorValue": {
                    "color": "#646464"
                },
                
                "light": {
                    "propertyName": {
                        "color": "#646464"
                    }
                },
                "dark": {
                    "number": {
                        "color": "#787878"
                    },
                    "pseudoSelectorOperator": {
                        "color": "#E69300"
                    },
                    "classSelector": {
                        "color": "#01768B"
                    },
                    "comment": {
                        "color": "#505050"
                    },
                    "string": {
                        "color": "#787878"
                    },
                }
            },
            "errors": {
                
                "foreground": {
                    "fontFamily": "Hack",
                    "fontSize": "10pt",
                    "color": "#124E78",
                },
                "unselectedErrorMessage": {
                    "color": "#01768B"
                },
                "selectedErrorMessage": {
                    "color": "#FF4E00"
                },
                "selectedWarningMessage": {
                    "color": "#E69300"
                },
                "light": {
                    "foreground": {
                        "color": "#124E78",
                    },
                    "unselectedErrorMessage": {
                        "color": "#01768B"
                    },
                    "selectedErrorMessage": {
                        "color": "#FF4E00"
                    }
                }
            }
        },
        
        "html": {
            
            
            "preview": {
                
                "dark": {
                    "foreground": {
                        "color": "rgb(242,242,242)",
                        "fontFamily": "-apple-system",
                    },
                    "background": {
                        "color": "rgb(30,30,30)"
                    },
                    "codeBackground": {
                        "color": "rgb(50,50,50)"
                    },
                    "linkColor" : {
                        "color": "rgb(242,242,242)"
                    },
                    "linkUnderline": {
                        "color": "rgb(242,242,242)"
                    },
                },
                "light": {
                    "foreground": {
                        "color": "black",
                        "fontFamily": "-apple-system",
                    },
                    "background": {
                        "color": "rgb(247,247,247)"
                    },
                    "codeBackground": {
                        "color": "rgb(230,230,230)"
                    },
                    "linkColor" : {
                        "color": "black"
                    },
                    "linkUnderline": {
                        "color": "black"
                    },
                    "h1": {
                        "color": "black"
                    },
                    "h2": {
                        "color": "black"
                    },
                    "h3": {
                        "color": "black"
                    },
                    "h4": {
                        "color": "black"
                    },
                    "h5": {
                        "color": "black"
                    },
                    "h6": {
                        "color": "black"
                    }
                }
            }
        }
    }
}











