@namespace "http://www.w3.org/Style/CSS/";

css-style-sheet {

    {# font-family #}
    {% if theme.css.source.light.foreground.fontFamily %}
        font-family: {{ theme.css.source.light.foreground.fontFamily }};
    {% elif theme.css.source.foreground.fontFamily %}
        font-family: {{ theme.css.source.foreground.fontFamily }};
    {% elif theme.css.light.foreground.fontFamily %}
        font-family: {{ theme.css.light.foreground.fontFamily }};
    {% elif theme.css.foreground.fontFamily %}
        font-family: {{ theme.css.foreground.fontFamily }};
    {% elif theme.light.foreground.fontFamily %}
        font-family: {{ theme.light.foreground.fontFamily }};
    {% elif theme.foreground.fontFamily %}
        font-family: {{ theme.foreground.fontFamily }};
    {% else %}
        font-family: Menlo;
    {% endif %}

    {# font-size #}
    {% if theme.css.source.light.foreground.fontSize %}
        font-size: {{ theme.css.source.light.foreground.fontSize }};
    {% elif theme.css.source.foreground.fontSize %}
        font-size: {{ theme.css.source.foreground.fontSize }};
    {% elif theme.css.light.foreground.fontSize %}
        font-size: {{ theme.css.light.foreground.fontSize }};
    {% elif theme.css.foreground.fontSize %}
        font-size: {{ theme.css.foreground.fontSize }};
    {% elif theme.light.foreground.fontSize %}
        font-size: {{ theme.light.foreground.fontSize }};
    {% elif theme.foreground.fontSize %}
        font-size: {{ theme.foreground.fontSize }};
    {% else %}
        font-size: 10pt;
    {% endif %}


    {# font-style #}
    {% if theme.css.source.light.foreground.fontStyle %}
        font-style: {{ theme.css.source.light.foreground.fontStyle }};
    {% elif theme.css.source.foreground.fontStyle %}
        font-style: {{ theme.css.source.foreground.fontStyle }};
    {% elif theme.css.light.foreground.fontStyle %}
        font-style: {{ theme.css.light.foreground.fontStyle }};
    {% elif theme.css.foreground.fontStyle %}
        font-style: {{ theme.css.foreground.fontStyle }};
    {% elif theme.light.foreground.fontStyle %}
        font-style: {{ theme.light.foreground.fontStyle }};
    {% elif theme.foreground.fontStyle %}
        font-style: {{ theme.foreground.fontStyle }};
    {% endif %}

    {# font-weight #}
    {% if theme.css.source.light.foreground.fontWeight %}
        font-weight: {{ theme.css.source.light.foreground.fontWeight }};
    {% elif theme.css.source.foreground.fontWeight %}
        font-weight: {{ theme.css.source.foreground.fontWeight }};
    {% elif theme.css.light.foreground.fontWeight %}
        font-weight: {{ theme.css.light.foreground.fontWeight }};
    {% elif theme.css.foreground.fontWeight %}
        font-weight: {{ theme.css.foreground.fontWeight }};
    {% elif theme.light.foreground.fontWeight %}
        font-weight: {{ theme.light.foreground.fontWeight }};
    {% elif theme.foreground.fontWeight %}
        font-weight: {{ theme.foreground.fontWeight }};
    {% endif %}

    {# color #}
    {% if theme.css.source.light.foreground.color %}
        color: {{ theme.css.source.light.foreground.color }};
    {% elif theme.css.source.foreground.color %}
        color: {{ theme.css.source.foreground.color }};
    {% elif theme.css.light.foreground.color %}
        color: {{ theme.css.light.foreground.color }};
    {% elif theme.css.foreground.color %}
        color: {{ theme.css.foreground.color }};
    {% elif theme.light.foreground.color %}
        color: {{ theme.light.foreground.color }};
    {% elif theme.foreground.color %}
        color: {{ theme.foreground.color }};
    {% endif %}

    {# background-color #}
    {% if theme.css.source.light.background.color %}
        background-color: {{ theme.css.source.light.background.color }};
    {% elif theme.css.source.background.color %}
        background-color: {{ theme.css.source.background.color }};
    {% elif theme.css.light.background.color %}
        background-color: {{ theme.css.light.background.color }};
    {% elif theme.css.background.color %}
        background-color: {{ theme.css.background.color }};
    {% elif theme.light.background.color %}
        background-color: {{ theme.light.background.color }};
    {% elif theme.background.color %}
        background-color: {{ theme.background.color }};
    {% else %}
        background-color: black;
    {% endif %}
}

