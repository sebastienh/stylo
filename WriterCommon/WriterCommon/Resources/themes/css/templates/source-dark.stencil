@namespace "http://www.w3.org/Style/CSS/";

css-style-sheet {

    {# font-family #}
    {% if theme.css.source.dark.foreground.fontFamily %}
        font-family: {{ theme.css.source.dark.foreground.fontFamily }};
    {% elif theme.css.source.foreground.fontFamily %} 
        font-family: {{ theme.css.source.foreground.fontFamily }};
    {% elif theme.css.dark.foreground.fontFamily %} 
        font-family: {{ theme.css.dark.foreground.fontFamily }};
    {% elif theme.css.foreground.fontFamily %} 
        font-family: {{ theme.css.foreground.fontFamily }};
    {% elif theme.dark.foreground.fontFamily %} 
        font-family: {{ theme.dark.foreground.fontFamily }};
    {% elif theme.foreground.fontFamily %} 
        font-family: {{ theme.foreground.fontFamily }};
    {% else %}
        font-family: Menlo;
    {% endif %}

    {# font-size #}
    {% if theme.css.source.dark.foreground.fontSize %}
        font-size: {{ theme.css.source.dark.foreground.fontSize }};
    {% elif theme.css.source.foreground.fontSize %} 
        font-size: {{ theme.css.source.foreground.fontSize }};
    {% elif theme.css.dark.foreground.fontSize %} 
        font-size: {{ theme.css.dark.foreground.fontSize }};
    {% elif theme.css.foreground.fontSize %} 
        font-size: {{ theme.css.foreground.fontSize }};
    {% elif theme.dark.foreground.fontSize %} 
        font-size: {{ theme.dark.foreground.fontSize }};
    {% elif theme.foreground.fontSize %} 
        font-size: {{ theme.foreground.fontSize }};
    {% else %}
        font-size: 10pt;
    {% endif %}


    {# font-style #}
    {% if theme.css.source.dark.foreground.fontStyle %}
        font-style: {{ theme.css.source.dark.foreground.fontStyle }};
    {% elif theme.css.source.foreground.fontStyle %}
        font-style: {{ theme.css.source.foreground.fontStyle }};
    {% elif theme.css.dark.foreground.fontStyle %}
        font-style: {{ theme.css.dark.foreground.fontStyle }};
    {% elif theme.css.foreground.fontStyle %}
        font-style: {{ theme.css.foreground.fontStyle }};
    {% elif theme.dark.foreground.fontStyle %}
        font-style: {{ theme.dark.foreground.fontStyle }};
    {% elif theme.foreground.fontStyle %}
        font-style: {{ theme.foreground.fontStyle }};
    {% endif %}

    {# font-weight #}
    {% if theme.css.source.dark.foreground.fontWeight %}
        font-weight: {{ theme.css.source.dark.foreground.fontWeight }};
    {% elif theme.css.source.foreground.fontWeight %}
        font-weight: {{ theme.css.source.foreground.fontWeight }};
    {% elif theme.css.dark.foreground.fontWeight %}
        font-weight: {{ theme.css.dark.foreground.fontWeight }};
    {% elif theme.css.foreground.fontWeight %}
        font-weight: {{ theme.css.foreground.fontWeight }};
    {% elif theme.dark.foreground.fontWeight %}
        font-weight: {{ theme.dark.foreground.fontWeight }};
    {% elif theme.foreground.fontWeight %}
        font-weight: {{ theme.foreground.fontWeight }};
    {% endif %}

    {# color #}
    {% if theme.css.source.dark.foreground.color %}
        color: {{ theme.css.source.dark.foreground.color }};
    {% elif theme.css.source.foreground.color %} 
        color: {{ theme.css.source.foreground.color }};
    {% elif theme.css.dark.foreground.color %} 
        color: {{ theme.css.dark.foreground.color }};
    {% elif theme.css.foreground.color %} 
        color: {{ theme.css.foreground.color }};
    {% elif theme.dark.foreground.color %} 
        color: {{ theme.dark.foreground.color }};
    {% elif theme.foreground.color %} 
        color: {{ theme.foreground.color }};        
    {% endif %}

    {# background-color #}
    {% if theme.css.source.dark.background.color %}
        background-color: {{ theme.css.source.dark.background.color }};
    {% elif theme.css.source.background.color %} 
        background-color: {{ theme.css.source.background.color }};
    {% elif theme.css.dark.background.color %} 
        background-color: {{ theme.css.dark.background.color }};
    {% elif theme.css.background.color %} 
        background-color: {{ theme.css.background.color }};
    {% elif theme.dark.background.color %} 
        background-color: {{ theme.dark.background.color }};
    {% elif theme.background.color %} 
        background-color: {{ theme.background.color }};
    {% else %}
        background-color: black;
    {% endif %}
}

