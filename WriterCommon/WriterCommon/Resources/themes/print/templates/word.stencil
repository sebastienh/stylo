body {

    tab-size:4;

    {# font-size #}
    {% if theme.print.word.body.fontSize %}
        font-size: {{ theme.print.word.body.fontSize }};
    {% elif theme.print.body.fontSize %}
        font-size: {{ theme.print.body.fontSize }};
    {% elif theme.body.fontSize %}
        font-size: {{ theme.body.fontSize }};
    {% endif %}

    {# font-family #}
    {% if theme.print.word.fontFamily %}
        font-family: {{ theme.print.word.fontFamily }};
    {% elif theme.print.fontFamily %}
        font-family: {{ theme.print.fontFamily }};
    {% elif theme.fontFamily %}
        font-family: {{ theme.fontFamily }};
    {% else %}
        font-family: "Arial";
    {% endif %}
}


h1 {

    {# font-size #}
    {% if theme.print.word.h1.fontSize %}
        font-size: {{ theme.print.word.h1.fontSize }};
    {% elif theme.print.h1.fontSize %}
        font-size: {{ theme.print.h1.fontSize }};
    {% elif theme.h1.fontSize %}
        font-size: {{ theme.h1.fontSize }};
    {% endif %}
    font-weight: 600;
}

